      }
    },
    "required": [
      "period",
      "metrics",
      "metric_status",
      "notes",
      "data_quality",
      "truncated",
      "disclaimer"
    ],
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false
  },
  "annotations": {
