{
  "name": "get_today",
  "description": "Get today's complete health snapshot — recovery score, last night's sleep, current strain, and last workout in one call. Today is the current WHOOP cycle, which starts at last night's sleep onset and stays open until WHOOP processes the next sleep (it can run longer than a day); sleep and recovery are the ones linked to that cycle. If no newer sleep has been processed yet (wake-up not synced, or no sleep detected), the most recent sleep and recovery are still returned with status stale in data_quality.sources and a note giving their date: do not present them as last night's. A cycle WHOOP has not updated for a day is shown with cycle status stale and a possibly-not-synced note. Sleep hours are time asleep (time_in_bed_hours is separate). recovery.user_calibrating=true means WHOOP is still learning the user's baselines and the score is provisional. A section is null when its data is not available yet or could not be fetched; `notes` explains why in plain language and data_quality.sources gives each source's status.",
  "inputSchema": {
    "type": "object",
    "properties": {},
    "$schema": "http://json-schema.org/draft-07/schema#"
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "timestamp": {
        "type": "string"
      },
      "recovery": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "score": {
                "type": "number"
              },
              "hrv_rmssd_milli": {
                "type": "number"
              },
              "resting_heart_rate": {
                "type": "number"
              },
              "spo2_pct": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "skin_temp_celsius": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "user_calibrating": {
                "type": "boolean"
              }
            },
            "required": [
              "score",
              "hrv_rmssd_milli",
              "resting_heart_rate",
              "spo2_pct",
              "skin_temp_celsius",
              "user_calibrating"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      },
      "sleep": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "total_hours": {
                "type": "number"
              },
              "time_in_bed_hours": {
                "type": "number"
              },
              "asleep_hours": {
                "type": "number"
              },
              "rem_hours": {
                "type": "number"
              },
              "deep_hours": {
                "type": "number"
              },
              "light_hours": {
                "type": "number"
              },
              "awake_hours": {
                "type": "number"
              },
              "performance_pct": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "efficiency_pct": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "respiratory_rate": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "total_hours",
              "time_in_bed_hours",
              "asleep_hours",
              "rem_hours",
              "deep_hours",
              "light_hours",
              "awake_hours",
              "performance_pct",
              "efficiency_pct",
              "respiratory_rate"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      },
      "strain": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "day_strain": {
                "type": "number"
              },
              "energy_burned_kj": {
                "type": "number"
              },
              "last_workout": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "sport_name": {
                        "type": "string"
                      },
                      "strain": {
                        "type": "number"
                      },
                      "occurred_at": {
                        "type": "string"
                      },
                      "percent_recorded": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "sport_name",
                      "strain",
                      "occurred_at",
                      "percent_recorded"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "day_strain",
              "energy_burned_kj",
              "last_workout"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      },
      "summary": {
        "type": "string"
      },
      "notes": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "data_quality": {
        "type": "object",
        "properties": {
          "evaluated_at": {
            "type": "string"
          },
          "requested_period": {
            "type": "object",
            "properties": {
              "start": {
                "type": "string"
              },
              "end": {
                "type": "string"
              }
            },
            "required": [
              "start",
              "end"
            ],
            "additionalProperties": false
          },
          "observed_period": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "start": {
                    "type": "string"
                  },
                  "end": {
                    "type": "string"
                  }
                },
                "required": [
                  "start",
                  "end"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "sources": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "available",
                    "pending",
                    "missing",
                    "stale",
                    "unscored",
                    "calibrating",
                    "invalid",
                    "fetch_failed"
                  ]
                },
                "fetched_at": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "source_updated_at": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "cache_status": {
                  "type": "string",
                  "enum": [
                    "hit",
                    "miss",
                    "unknown"
                  ]
                },
                "records_fetched": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "records_used": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "exclusions": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "truncated": {
                  "type": "boolean"
                }
              },
              "required": [
                "status",
                "fetched_at",
                "source_updated_at",
                "cache_status",
                "records_fetched",
                "records_used",
                "exclusions",
                "truncated"
              ],
              "additionalProperties": false
            }
          },
          "method_version": {
            "type": "string"
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "evaluated_at",
          "requested_period",
          "observed_period",
          "sources",
          "method_version",
          "limitations"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "timestamp",
      "recovery",
      "sleep",
      "strain",
      "summary",
      "notes",
      "data_quality"
    ],
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false
  },
  "annotations": {
    "readOnlyHint": true
  },
  "execution": {
    "taskSupport": "forbidden"
  }
}
