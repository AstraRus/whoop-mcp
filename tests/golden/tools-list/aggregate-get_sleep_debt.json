        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      },
      "status": {
        "type": "string",
        "enum": [
          "available",
          "insufficient_data",
          "unavailable"
        ]
      },
      "nights_required": {
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      },
      "total_debt_hours": {
        "anyOf": [
