              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "bedtime_std_dev_minutes",
          "waketime_std_dev_minutes",
          "social_jetlag_minutes"
        ],
        "additionalProperties": false
      },
      "output_capped": {
