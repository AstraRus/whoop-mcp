          },
          "first_day": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              {
                "type": "null"
              }
            ],
            "description": "Local day (YYYY-MM-DD) counted in the period; null when it covers no local day"
          },
          "last_day": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              {
                "type": "null"
              }
            ],
            "description": "Local day (YYYY-MM-DD) counted in the period; null when it covers no local day"
          }
        },
