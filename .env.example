# WHOOP Developer App credentials
# Create an app at https://developer.whoop.com
WHOOP_CLIENT_ID=your_client_id_here
WHOOP_CLIENT_SECRET=your_client_secret_here
WHOOP_REDIRECT_URI=http://localhost:3000/callback

# Optional: absolute path of the folder that holds tokens.json (default ~/.whoop-mcp).
# The server, setup, doctor and revoke must all use the same value.
# WHOOP_MCP_TOKEN_DIR=/data

# Every other variable (HTTP transport, OAuth connector, privacy mode, rate limit,
# webhooks, logging) is described in the README under "Environment variables".
